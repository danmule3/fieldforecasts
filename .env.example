APP_NAME="Field Forecast"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fieldforecasts
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@fieldforecasts.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Module 1: seeded Super Administrator (AdminUserSeeder) ---
# Leave blank in local/dev to get a random generated password printed
# to the console; ALWAYS set both in staging/production before seeding.
# Uncomment and set both before seeding anywhere beyond local dev.
# Leaving these commented out (not just blank) matters: env() only
# falls back to a default when the key is entirely absent — a blank
# `KEY=` line is treated as "set to empty string", which broke the
# admin email during initial setup (see AdminUserSeeder).
# SEED_ADMIN_EMAIL=admin@fieldforecasts.test
# SEED_ADMIN_PASSWORD=

# --- Module 7: external sports-data API ---
# All optional — the platform runs entirely on manually-entered admin
# data (NullSportsDataProvider) until an ApiKey is added in
# Admin > API Keys AND these are configured for the real vendor.
SPORTS_API_PROVIDER=sportsdata
SPORTS_API_BASE_URL=https://api.example-sportsdata.com/v2
SPORTS_API_TIMEOUT=10
SPORTS_API_RETRY_TIMES=3
SPORTS_API_RETRY_DELAY_MS=200
SPORTS_API_RATE_LIMIT=60
SPORTS_API_CACHE_TTL=60
